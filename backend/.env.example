PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/scamverse360
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# --- Phase 4: Blockchain (optional) ---
# Leave any of these blank/unset to run with the blockchain layer disabled;
# threat reporting keeps working normally off-chain (Phases 1-3 behavior).
# For a local Hardhat node: cd blockchain && npm run node   (then run deploy:localhost in another terminal)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=
THREAT_REGISTRY_CONTRACT_ADDRESS=

# --- Phase 5: Evidence & IPFS (optional) ---
# 32 random bytes, hex-encoded (e.g. `openssl rand -hex 32`). Required in production;
# a clearly-insecure fallback demo key is used if unset, with a console warning.
EVIDENCE_ENCRYPTION_KEY=
# Leave unset to use the built-in IPFS mock (no real IPFS node contacted).
# Set to a running Kubo/IPFS HTTP API endpoint (e.g. http://127.0.0.1:5001) to pin
# non-sensitive evidence for real. Falls back to the mock automatically if unreachable.
IPFS_API_URL=
